# Auto detect text files and normalize to LF on commit
* text=auto eol=lf

# Explicitly declare text files to always have LF endings
*.js text eol=lf working-tree-encoding=UTF-8
*.jsx text eol=lf working-tree-encoding=UTF-8
*.ts text eol=lf working-tree-encoding=UTF-8
*.tsx text eol=lf working-tree-encoding=UTF-8
*.json text eol=lf working-tree-encoding=UTF-8
*.css text eol=lf working-tree-encoding=UTF-8
*.scss text eol=lf working-tree-encoding=UTF-8
*.html text eol=lf working-tree-encoding=UTF-8
*.md text eol=lf working-tree-encoding=UTF-8
*.yml text eol=lf working-tree-encoding=UTF-8
*.yaml text eol=lf working-tree-encoding=UTF-8
*.xml text eol=lf working-tree-encoding=UTF-8
*.svg text eol=lf working-tree-encoding=UTF-8

# .NET files
*.cs text eol=lf working-tree-encoding=UTF-8

# Python files
*.py text eol=lf working-tree-encoding=UTF-8
*.pyi text eol=lf working-tree-encoding=UTF-8
*.pyx text eol=lf working-tree-encoding=UTF-8

# Config files
*.ini text eol=lf working-tree-encoding=UTF-8
*.cfg text eol=lf working-tree-encoding=UTF-8
*.conf text eol=lf working-tree-encoding=UTF-8
*.toml text eol=lf working-tree-encoding=UTF-8
*.env text eol=lf working-tree-encoding=UTF-8
.gitignore text eol=lf working-tree-encoding=UTF-8
.gitattributes text eol=lf working-tree-encoding=UTF-8
.editorconfig text eol=lf working-tree-encoding=UTF-8
Makefile text eol=lf working-tree-encoding=UTF-8

# Shell scripts (must be LF)
*.sh text eol=lf working-tree-encoding=UTF-8
*.bash text eol=lf working-tree-encoding=UTF-8

# Windows batch files (keep CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files (don't touch)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
