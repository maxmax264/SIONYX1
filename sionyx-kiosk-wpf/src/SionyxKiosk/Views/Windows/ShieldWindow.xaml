<Window x:Class="SionyxKiosk.Views.Windows.ShieldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIONYX"
        WindowStartupLocation="Manual" Left="0" Top="0"
        Width="{x:Static SystemParameters.VirtualScreenWidth}"
        Height="{x:Static SystemParameters.VirtualScreenHeight}"
        WindowStyle="None"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False">
    <!--
        Permanent background layer, created once at app startup and never
        closed. Sits Topmost underneath AuthWindow/MainWindow for the entire
        app lifetime. If there's ever a split-second gap during a window
        transition (login, logout, update install, etc.) where neither of
        those is fully painted, this branded screen is what's revealed
        instead of the real Windows desktop - so any residual timing gap
        looks intentional rather than like a glitch.

        NOTE: deliberately NOT using WindowState="Maximized" - combined with
        ShowActivated="False" that throws InvalidOperationException at
        Show() ("Cannot show Window when ShowActivated is false and
        WindowState is set to Maximized") and crashes the whole app before
        logging is even initialized. Full-screen coverage is achieved via
        explicit Left/Top/Width/Height instead.
    -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0f1117" Offset="0"/>
                <GradientStop Color="#1a1330" Offset="0.55"/>
                <GradientStop Color="#241a3d" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <TextBlock Text="SIONYX" FontSize="56" FontWeight="Bold"
                   Foreground="#8B5CF6" Opacity="0.35"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
