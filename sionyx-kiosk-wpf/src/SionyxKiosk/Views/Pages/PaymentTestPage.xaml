<Page x:Class="SionyxKiosk.Views.Pages.PaymentTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:SionyxKiosk.Views.Controls"
      Title="תשלום (בדיקה)" FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="תשלום (בדיקה)"
                             Subtitle="לבדיקת אסטרטגיות חיוב מול נדרים - כל ניסיון עלול לחייב ₪1 אמיתי"
                             HeaderBrush="{StaticResource HelpHeaderGradient}" Icon="🧪"
                             Margin="0,0,0,24" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Strategy list -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <ItemsControl ItemsSource="{Binding Strategies}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="{StaticResource RadiusLg}" Padding="16" Margin="0,0,0,10"
                                    Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.65"
                                               TextWrapping="Wrap" Margin="0,4,0,10" />
                                    <Button Content="נסה אסטרטגיה זו" HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.RunStrategyCommand,
                                                      RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding Key}"
                                            IsEnabled="{Binding DataContext.IsBusy,
                                                        RelativeSource={RelativeSource AncestorType=Page},
                                                        Converter={StaticResource InverseBool}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Result panel -->
            <Border Grid.Column="1" CornerRadius="{StaticResource RadiusLg}" Background="#1E1E1E" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding LastStrategyLabel, StringFormat='תוצאה אחרונה: {0}'}"
                               Foreground="White" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas"
                                 FontSize="13" Foreground="#D4D4D4" Background="Transparent"
                                 BorderThickness="0" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
