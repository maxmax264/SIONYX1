<Window x:Class="SionyxKiosk.Views.Dialogs.PaymentTokenTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="בדיקת טוקן באייפרם" WindowState="Maximized"
        FlowDirection="RightToLeft" Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#4F46E5" Padding="16,10">
            <Grid>
                <TextBlock Text="בדיקת טוקן דרך האייפרם המקורי" Foreground="White"
                           FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                <Button Content="סגור ✕" HorizontalAlignment="Left" Click="CloseButton_Click"
                        Background="Transparent" Foreground="White" BorderThickness="0" Padding="10,4" />
            </Grid>
        </Border>
        <wv2:WebView2 x:Name="TestWebView" Grid.Row="1" />
    </Grid>
</Window>
