<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <AssemblyName>SionyxInputInjector</AssemblyName>
    <Product>SIONYX Input Injector</Product>
    <Company>SIONYX Technologies</Company>
    <Description>
      SYSTEM-privileged Windows Service that injects mouse clicks on request
      from VncRelayService, via a local named pipe. Exists solely to reach
      UI elements that ignore input injected from a normal (non-elevated)
      process - see docs/REMOTE-CONTROL-ELEVATED-CLICK.md for why this is
      a separate SYSTEM service instead of just calling SendInput from
      SionyxKiosk itself.
    </Description>
    <UserSecretsId>dotnet-SionyxInputInjector</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <!-- Required for NamedPipeServerStreamAcl/PipeSecurity/PipeAccessRule in
         PipeServerWorker.cs. On every TFM from net5.0 through net10.0 these
         types live in a separate assembly that is NOT part of the shared
         framework - only from net11.0 onward is it built in. Without this
         reference the project fails to compile (CS0246), which is exactly
         what was silently happening on every build - see PipeServerWorker.cs
         and build.ps1's Invoke-PublishInputInjector for why that failure was
         never visible. -->
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <!-- VncHostWorker runs the kiosk's VNC bridge (VncRelayService) inside this
         service so it works at the Windows login screen. The shared files
         below use Serilog and ServiceController. -->
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Worker SDK's implicit "using Microsoft.Extensions.Logging" makes the
         shared kiosk files' "ILogger" ambiguous with Serilog.ILogger (CS0104).
         Every injector file that needs MEL has its own explicit using. -->
    <Using Remove="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same source files as SionyxKiosk.exe (no copy to keep in sync). -->
    <Compile Include="..\SionyxKiosk\Infrastructure\FirebaseClient.cs" Link="Shared\FirebaseClient.cs" />
    <Compile Include="..\SionyxKiosk\Infrastructure\IFirebaseClient.cs" Link="Shared\IFirebaseClient.cs" />
    <Compile Include="..\SionyxKiosk\Infrastructure\FirebaseConfig.cs" Link="Shared\FirebaseConfig.cs" />
    <Compile Include="..\SionyxKiosk\Infrastructure\SseListener.cs" Link="Shared\SseListener.cs" />
    <Compile Include="..\SionyxKiosk\Infrastructure\DeviceInfo.cs" Link="Shared\DeviceInfo.cs" />
    <Compile Include="..\SionyxKiosk\Infrastructure\RegistryConfig.cs" Link="Shared\RegistryConfig.cs" />
    <Compile Include="..\SionyxKiosk\Infrastructure\ServerResolver.cs" Link="Shared\ServerResolver.cs" />
    <Compile Include="..\SionyxKiosk\Infrastructure\DotEnvLoader.cs" Link="Shared\DotEnvLoader.cs" />
    <Compile Include="..\SionyxKiosk\Infrastructure\ErrorTranslations.cs" Link="Shared\ErrorTranslations.cs" />
    <Compile Include="..\SionyxKiosk\Services\HttpRelayWebSocket.cs" Link="Shared\HttpRelayWebSocket.cs" />
    <Compile Include="..\SionyxKiosk\Services\VncRelayService.cs" Link="Shared\VncRelayService.cs" />
  </ItemGroup>

</Project>
