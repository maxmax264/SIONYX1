<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <AssemblyName>SionyxGuard</AssemblyName>
    <RootNamespace>SionyxGuard</RootNamespace>
    <Product>SIONYX Guard</Product>
    <Company>SIONYX Technologies</Company>
    <Description>
      SYSTEM Windows service that supervises SionyxKiosk.exe. If the kiosk app
      crashes or freezes, it immediately covers the screen (the same exe re-run
      with --lock inside the user session), restarts the app, and forces a
      logoff if recovery fails. See docs/CRASH-GUARD.md.
    </Description>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Worker SDK's implicit MEL using clashes with Serilog.ILogger; same fix as SionyxInputInjector. -->
    <Using Remove="Microsoft.Extensions.Logging" />
    <Using Remove="System.Net.Http" />
  </ItemGroup>

</Project>
